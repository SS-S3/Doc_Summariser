# ------------------------------------------------------------------
# Document Intelligence Platform — Environment Configuration
# Copy this file to `.env` and edit values as needed:
#   cp .env.example .env
# ------------------------------------------------------------------

# --- Backend / Django -------------------------------------------------
# Dev mode (set to true for local development)
DEBUG=true

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=127.0.0.1,localhost

# Database engine for development.
# Defaults to SQLite (zero-config). To use MySQL, set to:
#   DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_ENGINE=django.db.backends.sqlite3

# SQLite database file location (only used when engine is SQLite)
SQLITE_DB_NAME=backend/db.sqlite3

# MySQL credentials (only used when DJANGO_DB_ENGINE is mysql)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=document_intelligence

# CORS — allow all origins in development
CORS_ALLOW_ALL_ORIGINS=true

# Upload endpoint used by the scraper
UPLOAD_URL=http://127.0.0.1:8000/api/books/upload/

# --- AI / LLM Configuration -------------------------------------------
# Mode: groq (default) or openai
LLM_MODE=groq

# Groq (default provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (fallback provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

